{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cb-identityjs2026/post-grid",
	"title": "CB Post Grid",
	"category": "cb-identityjs2026",
	"icon": "grid-view",
	"attributes": {
		"querySource": { "type": "string", "default": "category" },
		"category": { "type": "number", "default": 0 },
		"taxonomyName": { "type": "string", "default": "theme" },
		"taxonomyTerm": { "type": "number", "default": 0 },
		"count": { "type": "number", "default": 3 },
		"showCategory": { "type": "boolean", "default": true },
		"showDate": { "type": "boolean", "default": true }
	},
	"supports": {
		"anchor": true,
		"className": true,
		"align": true
	},
	"editorScript": "file:./build/index.js",
	"render": "file:./render.php"
}
